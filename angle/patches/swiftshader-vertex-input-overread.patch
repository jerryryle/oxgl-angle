+// GuardedMemory maps `size` bytes of read-write memory followed by `size`
+// bytes that cannot be accessed, so that any read past the end of the
+// read-write part faults.
+class GuardedMemory
+{
+public:
+	explicit GuardedMemory(size_t size)
+	    : size(size)
+	{
+#if defined(_WIN32)
+		void *mapping = VirtualAlloc(nullptr, 2 * size, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+		DWORD oldProtection = 0;
+		if(mapping && VirtualProtect(static_cast<uint8_t *>(mapping) + size, size, PAGE_NOACCESS, &oldProtection))
+		{
+			memory = mapping;
+		}
+#else
+		void *mapping = mmap(nullptr, 2 * size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+		if(mapping != MAP_FAILED && mprotect(static_cast<uint8_t *>(mapping) + size, size, PROT_NONE) == 0)
+		{
+			memory = mapping;
+		}
+#endif
+	}
+
+	~GuardedMemory()
+	{
+		if(memory)
+		{
+#if defined(_WIN32)
+			VirtualFree(memory, 0, MEM_RELEASE);
+#else
+			munmap(memory, 2 * size);
+#endif
+		}
+	}
+
+	// Returns the start of the read-write part, or nullptr if mapping failed.
+	void *data() const { return memory; }
+
+	// Returns the size of the system's memory pages.
+	static size_t pageSize()
+	{
+#if defined(_WIN32)
+		SYSTEM_INFO systemInfo;
+		GetSystemInfo(&systemInfo);
+		return systemInfo.dwPageSize;
+#else
+		return static_cast<size_t>(sysconf(_SC_PAGESIZE));
+#endif
+	}
+
+private:
+	const size_t size;
+	void *memory = nullptr;
+};
+
+// Returns the index of the lowest bit set in `bits`, or -1 if none is set.
+int lowestBit(uint32_t bits)
+{
+	for(int i = 0; i < 32; i++)
+	{
+		if(bits & (1u << i))
+		{
+			return i;
+		}
+	}
+	return -1;
+}
+
+// A vertex shader that writes its vec2 attribute at location 0 to element
+// gl_VertexIndex of the storage buffer at set 0, binding 0.
+const char *const kVertexShader = R"(
+               OpCapability Shader
+               OpMemoryModel Logical GLSL450
+               OpEntryPoint Vertex %main "main" %attribute %vertexIndex %perVertex
+               OpDecorate %attribute Location 0
+               OpDecorate %vertexIndex BuiltIn VertexIndex
+               OpMemberDecorate %PerVertex 0 BuiltIn Position
+               OpMemberDecorate %PerVertex 1 BuiltIn PointSize
+               OpDecorate %PerVertex Block
+               OpDecorate %Values ArrayStride 8
+               OpMemberDecorate %Result 0 Offset 0
+               OpDecorate %Result BufferBlock
+               OpDecorate %result DescriptorSet 0
+               OpDecorate %result Binding 0
+       %void = OpTypeVoid
+   %voidFunc = OpTypeFunction %void
+      %float = OpTypeFloat 32
+    %v2float = OpTypeVector %float 2
+    %v4float = OpTypeVector %float 4
+        %int = OpTypeInt 32 1
+      %int_0 = OpConstant %int 0
+      %int_1 = OpConstant %int 1
+    %float_0 = OpConstant %float 0
+    %float_1 = OpConstant %float 1
+   %position = OpConstantComposite %v4float %float_0 %float_0 %float_0 %float_1
+ %inputVec2Ptr = OpTypePointer Input %v2float
+  %attribute = OpVariable %inputVec2Ptr Input
+%inputIntPtr = OpTypePointer Input %int
+%vertexIndex = OpVariable %inputIntPtr Input
+  %PerVertex = OpTypeStruct %v4float %float
+%outputPerVertexPtr = OpTypePointer Output %PerVertex
+  %perVertex = OpVariable %outputPerVertexPtr Output
+%outputVec4Ptr = OpTypePointer Output %v4float
+%outputFloatPtr = OpTypePointer Output %float
+     %Values = OpTypeRuntimeArray %v2float
+     %Result = OpTypeStruct %Values
+%uniformResultPtr = OpTypePointer Uniform %Result
+     %result = OpVariable %uniformResultPtr Uniform
+%uniformVec2Ptr = OpTypePointer Uniform %v2float
+       %main = OpFunction %void None %voidFunc
+      %entry = OpLabel
+      %value = OpLoad %v2float %attribute
+      %index = OpLoad %int %vertexIndex
+        %out = OpAccessChain %uniformVec2Ptr %result %int_0 %index
+               OpStore %out %value
+%positionOut = OpAccessChain %outputVec4Ptr %perVertex %int_0
+               OpStore %positionOut %position
+%pointSizeOut = OpAccessChain %outputFloatPtr %perVertex %int_1
+               OpStore %pointSizeOut %float_1
+               OpReturn
+               OpFunctionEnd
+)";
+
+}  // anonymous namespace
