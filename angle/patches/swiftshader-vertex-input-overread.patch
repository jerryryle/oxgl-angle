 		source3 = IfThenElse(limits.w > robustnessSize, zeroSource, source3);
 	}
 
+	// The format cases below load 4, 8 or 16 bytes per attribute whatever the
+	// format's own size (a Float4 for VK_FORMAT_R32G32_SFLOAT, a Byte4 for
+	// VK_FORMAT_R8_UNORM), so for a vertex at the end of a buffer that ends
+	// at the end of its memory they read past the allocation. Read each
+	// attribute's own bytes into a zeroed 16-byte local instead.
+	UInt4 attribute0(0);
+	UInt4 attribute1(0);
+	UInt4 attribute2(0);
+	UInt4 attribute3(0);
+	if(format.bytes() < 16)
+	{
+		copyAttribute(As<Pointer<Byte>>(&attribute0), source0, format.bytes());
+		copyAttribute(As<Pointer<Byte>>(&attribute1), source1, format.bytes());
+		copyAttribute(As<Pointer<Byte>>(&attribute2), source2, format.bytes());
+		copyAttribute(As<Pointer<Byte>>(&attribute3), source3, format.bytes());
+		source0 = As<Pointer<Byte>>(&attribute0);
+		source1 = As<Pointer<Byte>>(&attribute1);
+		source2 = As<Pointer<Byte>>(&attribute2);
+		source3 = As<Pointer<Byte>>(&attribute3);
+	}
+
 	int componentCount = format.componentCount();
 	bool normalized = !format.isUnnormalizedInteger();
 	bool isNativeFloatAttrib = (stream.attribType == Spirv::ATTRIBTYPE_FLOAT) || normalized;
