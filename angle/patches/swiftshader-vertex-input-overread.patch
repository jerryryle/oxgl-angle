+// Copies one vertex attribute's `bytes` bytes from `from` to `to`, in the
+// widest pieces that fit, so the read never goes past the attribute.
+static void copyAttribute(Pointer<Byte> to, Pointer<Byte> from, int bytes)
+{
+	int i = 0;
+	for(; i + 4 <= bytes; i += 4)
+	{
+		*Pointer<Int>(to + i) = *Pointer<Int>(from + i);
+	}
+	for(; i + 2 <= bytes; i += 2)
+	{
+		*Pointer<Short>(to + i) = *Pointer<Short>(from + i);
+	}
+	for(; i < bytes; i++)
+	{
+		*Pointer<Byte>(to + i) = *Pointer<Byte>(from + i);
+	}
+}
