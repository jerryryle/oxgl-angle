+// Test that a glCopyTexImage2D entirely outside a half-float framebuffer defines a zero-filled
+// luminance/alpha texture that samples with the destination format's channels.
+TEST_P(WebGLCompatibilityTest, CopyTexImageOutsideFloatFramebufferToLUMA)
+{
+    ANGLE_SKIP_TEST_IF(getClientMajorVersion() >= 3);
+    ANGLE_SKIP_TEST_IF(!EnsureGLExtensionEnabled("GL_OES_texture_half_float") ||
+                       !EnsureGLExtensionEnabled("GL_EXT_color_buffer_half_float"));
+
+    ANGLE_GL_PROGRAM(program, essl1_shaders::vs::Texture2D(), essl1_shaders::fs::Texture2D());
+
+    constexpr GLsizei kSize = 4;
+    const struct
+    {
+        GLenum format;
+        GLColor expected;
+    } kCases[] = {{GL_LUMINANCE, GLColor::black},
+                  {GL_ALPHA, GLColor::transparentBlack},
+                  {GL_LUMINANCE_ALPHA, GLColor::transparentBlack}};
+
+    GLTexture source;
+    glBindTexture(GL_TEXTURE_2D, source);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, kSize, kSize, 0, GL_RGBA, GL_HALF_FLOAT_OES, nullptr);
+
+    GLFramebuffer framebuffer;
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, source, 0);
+    ASSERT_GL_FRAMEBUFFER_COMPLETE(GL_FRAMEBUFFER);
+
+    for (const auto &testCase : kCases)
+    {
+        SCOPED_TRACE(testing::Message() << "format=0x" << std::hex << testCase.format);
+
+        GLTexture texture;
+        glBindTexture(GL_TEXTURE_2D, texture);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+
+        glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+        glCopyTexImage2D(GL_TEXTURE_2D, 0, testCase.format, kSize, kSize, kSize, kSize, 0);
+        ASSERT_GL_NO_ERROR();
+
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        drawQuad(program, essl1_shaders::PositionAttrib(), 0.5f, 1.0f, true);
+        EXPECT_PIXEL_COLOR_EQ(getWindowWidth() / 2, getWindowHeight() / 2, testCase.expected);
+    }
+}
