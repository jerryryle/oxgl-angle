+    ANGLE_GL_PROGRAM(program, essl1_shaders::vs::Texture2D(), essl1_shaders::fs::Texture2D());
+
+    constexpr GLsizei kSize  = 4;
+    constexpr GLushort kHalf = 0x3800;  // 0.5
+    const struct
+    {
+        GLenum format;
+        GLColor expected;
+    } kCases[] = {{GL_LUMINANCE, GLColor(128, 128, 128, 255)},
+                  {GL_ALPHA, GLColor(0, 0, 0, 128)},
+                  {GL_LUMINANCE_ALPHA, GLColor(128, 128, 128, 128)}};
+
+    GLTexture source;
+    glBindTexture(GL_TEXTURE_2D, source);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, kSize, kSize, 0, GL_RGBA, GL_HALF_FLOAT_OES, nullptr);
