+    constexpr std::array<SourceFormatCase, 3> kSourceFormats = {{
+        {GL_RGBA4, true},
+        {GL_RGB5_A1, true},
+        {GL_RGB565, false},
+    }};
+
+    for (const SourceFormatCase &src : kSourceFormats)
+    {
+        GLFramebuffer fbo;
+        GLRenderbuffer rbo;
+        glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+        glBindRenderbuffer(GL_RENDERBUFFER, rbo);
