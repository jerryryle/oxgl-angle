+// Test that copying a half-float texture level into itself as a luminance/alpha format keeps the
+// luminance and alpha channels.
+TEST_P(CopyTexImageTest, HalfFloatToSameTextureLUMA)
+{
+    ANGLE_SKIP_TEST_IF(getClientMajorVersion() >= 3);
+    ANGLE_SKIP_TEST_IF(!EnsureGLExtensionEnabled("GL_OES_texture_half_float") ||
+                       !EnsureGLExtensionEnabled("GL_EXT_color_buffer_half_float"));
+
+    ANGLE_GL_PROGRAM(program, essl1_shaders::vs::Texture2D(), essl1_shaders::fs::Texture2D());
+
+    constexpr GLsizei kSize  = 4;
+    const GLColor kLuminance = GLColor(64, 64, 64, 255);
+    const GLColor kAlpha     = GLColor(0, 0, 0, 191);
+    const GLColor kLumAlpha  = GLColor(64, 64, 64, 191);
+    const struct
+    {
+        GLenum format;
+        GLColor expected;
+    } kCases[] = {{GL_LUMINANCE, kLuminance}, {GL_ALPHA, kAlpha}, {GL_LUMINANCE_ALPHA, kLumAlpha}};
+
+    for (const auto &testCase : kCases)
+    {
+        SCOPED_TRACE(testing::Message() << "format=0x" << std::hex << testCase.format);
+
+        GLTexture texture;
+        glBindTexture(GL_TEXTURE_2D, texture);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, kSize, kSize, 0, GL_RGBA, GL_HALF_FLOAT_OES,
+                     nullptr);
+
+        GLFramebuffer framebuffer;
+        glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+        ASSERT_GL_FRAMEBUFFER_COMPLETE(GL_FRAMEBUFFER);
+
+        glClearColor(0.25f, 0.5f, 0.75f, 0.75f);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glCopyTexImage2D(GL_TEXTURE_2D, 0, testCase.format, 0, 0, kSize, kSize, 0);
+        ASSERT_GL_NO_ERROR();
+
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        drawQuad(program, essl1_shaders::PositionAttrib(), 0.5f);
+        EXPECT_PIXEL_COLOR_NEAR(getWindowWidth() / 2, getWindowHeight() / 2, testCase.expected, 2);
+    }
+}
