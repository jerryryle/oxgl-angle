+// level defined by copying a half-float framebuffer.
+TEST_P(CopyTexImageTest, HalfFloatLUMAUploadAfterCopy)
+{
+    ANGLE_SKIP_TEST_IF(getClientMajorVersion() >= 3);
+    // Only the OpenGL backend keeps the source's half-float type in an ES 2.0 copy; the others
+    // copy into 8-bit formats, which reject half-float uploads.
+    ANGLE_SKIP_TEST_IF(!IsOpenGL());
+    ANGLE_SKIP_TEST_IF(!EnsureGLExtensionEnabled("GL_OES_texture_half_float") ||
+                       !EnsureGLExtensionEnabled("GL_EXT_color_buffer_half_float"));
