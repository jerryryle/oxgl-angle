                                                    const angle::FeaturesGL &features,
-                                                   GLenum internalFormat)
+                                                   GLenum internalFormat,
+                                                   GLenum type)
 {
     CopyTexImageImageFormat result;
-    const gl::InternalFormat &formatInfo =
-        gl::GetInternalFormatInfo(internalFormat, GL_UNSIGNED_BYTE);
+    const gl::InternalFormat &formatInfo = GetCopyTexImageInternalFormatInfo(internalFormat, type);
+    if (functions->isAtLeastGLES(gl::Version(3, 0)) && formatInfo.componentType == GL_FLOAT &&
+        formatInfo.isLUMA())
+    {
+        // OpenGL ES 3.0 has no sized floating-point luminance or alpha formats, and drivers such
+        // as Mesa's refuse to copy a floating-point color buffer into the unsized ones. Back them
+        // with R or RG textures, as when the driver lacks OES_texture_half_float or
+        // OES_texture_float.
+        result.internalFormat = EmulateLUMA(formatInfo).sizedInternalFormat;
+        return result;
+    }
     result.internalFormat = GetTexImageNativeInternalFormat(functions, features, formatInfo);
     return result;
 }
