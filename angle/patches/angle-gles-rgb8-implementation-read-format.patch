+const gl::InternalFormat &FramebufferGL::getImplementationColorReadFormat(
+    const gl::Context *context) const
+{
+    const gl::InternalFormat &format = *mState.getReadAttachment()->getFormat().info;
+
+    // An OpenGL ES driver reads a normalized fixed-point color buffer only as RGBA/UNSIGNED_BYTE
+    // or as its own implementation-chosen format and type (ES 3.0.6 section 4.3.2). Drivers that
+    // store RGB8 padded to four components, such as Mesa's, choose RGBA, so passing an RGB read
+    // through would fail. Advertise RGBA, which every driver accepts.
+    if (GetFunctionsGL(context)->standard == STANDARD_GL_ES &&
+        format.sizedInternalFormat == GL_RGB8)
+    {
+        return gl::GetSizedInternalFormatInfo(GL_RGBA8);
+    }
+    return format;
+}
