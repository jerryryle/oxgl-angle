+const gl::InternalFormat &FramebufferGL::getImplementationColorReadFormat(
+    const gl::Context *context) const
+{
+    const gl::InternalFormat &format = *mState.getReadAttachment()->getFormat().info;
+    if (GetFunctionsGL(context)->standard != STANDARD_GL_ES)
+    {
+        return format;
+    }
+
+    // An OpenGL ES driver reads a color buffer only in the format and type ES 3.0.6 section 4.3.2
+    // requires for its component type, or in its own implementation-chosen format and type, which
+    // can differ from the attachment's. Advertise the required pair where the driver may not
+    // accept the attachment's own format and type:
+    // - RGBA/UNSIGNED_BYTE for RGB8, which drivers such as Mesa's store padded to four components
+    //   and read as RGBA.
+    // - RGBA_INTEGER/UNSIGNED_INT for 16-bit unsigned integer formats, which drivers such as
+    //   Mesa's reject reading as RGBA_INTEGER/UNSIGNED_SHORT.
+    if (format.sizedInternalFormat == GL_RGB8)
+    {
+        return gl::GetSizedInternalFormatInfo(GL_RGBA8);
+    }
+    if (format.componentType == GL_UNSIGNED_INT && format.type == GL_UNSIGNED_SHORT)
+    {
+        return gl::GetSizedInternalFormatInfo(GL_RGBA32UI);
+    }
+    return format;
+}
