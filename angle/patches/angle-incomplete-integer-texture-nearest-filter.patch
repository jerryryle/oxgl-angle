+// Verifies that filtered sampling of incomplete integer textures returns the default value. The
+// IntegerType tests use texelFetch, which bypasses filtering.
+TEST_P(IncompleteTextureTestES3, IntegerTypeFilteredSample)
+{
+    // GLES backend on Adreno has a problem to create a incomplete texture, although it doesn't go
+    // through the routine which creates a incomplete texture in the ANGLE driver.
+    ANGLE_SKIP_TEST_IF(IsAdreno() && IsAndroid() && IsOpenGLES());
+
+    constexpr char kVS[] = R"(#version 300 es
+in highp vec2 position;
+out highp vec2 texCoord;
+void main()
+{
+    gl_Position = vec4(position, 0, 1);
+    texCoord = (position * 0.5) + 0.5;
+})";
+
+    constexpr char kSignedFS[] = R"(#version 300 es
+in highp vec2 texCoord;
+out highp vec4 color;
+uniform highp isampler2D tex;
+void main()
+{
+    color = vec4(texture(tex, texCoord)) / 127.0;
+})";
+
+    constexpr char kUnsignedFS[] = R"(#version 300 es
+in highp vec2 texCoord;
+out highp vec4 color;
+uniform highp usampler2D tex;
+void main()
+{
+    color = vec4(texture(tex, texCoord)) / 255.0;
+})";
+
+    for (const char *fs : {kSignedFS, kUnsignedFS})
+    {
+        glClearColor(1.0f, 1.0f, 1.0f, 1.0f);
+        glClear(GL_COLOR_BUFFER_BIT);
+
+        // Since no texture has been bound, it is incomplete by definition.
+        ANGLE_GL_PROGRAM(program, kVS, fs);
+        drawQuad(program, "position", 0.5f);
+        ASSERT_GL_NO_ERROR();
+
+        const int width  = getWindowWidth() - 1;
+        const int height = getWindowHeight() - 1;
+        EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::black);
+        EXPECT_PIXEL_COLOR_EQ(width, 0, GLColor::black);
+        EXPECT_PIXEL_COLOR_EQ(0, height, GLColor::black);
+        EXPECT_PIXEL_COLOR_EQ(width, height, GLColor::black);
+    }
+}
+
 ANGLE_INSTANTIATE_TEST_ES2(IncompleteTextureTest);
 
 GTEST_ALLOW_UNINSTANTIATED_PARAMETERIZED_TEST(IncompleteTextureTestES3);
