         ASSERT(!t->hasObservers());
         t->setCompareMode(context, GL_COMPARE_REF_TO_TEXTURE);
     }
+    else if (format == gl::SamplerFormat::Unsigned || format == gl::SamplerFormat::Signed)
+    {
+        // Integer textures cannot be filtered linearly: GL makes them incomplete and Vulkan leaves
+        // the result undefined. Replace the default linear filters with nearest filtering so that
+        // filtered sampling returns the incomplete texture's value.
+        ASSERT(!t->hasObservers());
+        t->setMinFilter(context, GL_NEAREST);
+        t->setMagFilter(context, GL_NEAREST);
+    }
 
     ANGLE_TRY(t->syncState(context, gl::Command::Other));
 
