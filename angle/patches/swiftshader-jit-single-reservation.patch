+// A routine's code reaches its constant data with PC-relative relocations of
+// limited reach, such as AArch64's ADRP (+/-4 GiB). The JIT used to map each
+// section separately, so on Windows the data could land beyond that reach and
+// the routine read its constants from the wrong address. This test checks that
+// the constant data lies in the same block of pages as the code.
+TEST(ReactorUnitTests, ConstantDataIsNearCode)
+{
+	const int value = 123;
+
+	FunctionT<const void *()> function;
+	{
+		Return(ConstantData(&value, sizeof(value)));
+	}
+
+	auto routine = function(testName().c_str());
+	const void *data = routine();
+	const void *code = reinterpret_cast<const void *>(routine.getEntry());
+	EXPECT_EQ(*static_cast<const int *>(data), value);
+
+	// The test routine is tiny, so its sections span a few pages at most.
+	const uintptr_t distance = (data > code)
+	                               ? reinterpret_cast<uintptr_t>(data) - reinterpret_cast<uintptr_t>(code)
+	                               : reinterpret_cast<uintptr_t>(code) - reinterpret_cast<uintptr_t>(data);
+	EXPECT_LT(distance, uintptr_t(1) << 20);
+
+#if defined(_WIN32)
+	// Separately mapped sections often land next to each other anyway, so the
+	// distance check cannot tell them from one mapping. Windows records the base
+	// of each mapping, which can.
+	MEMORY_BASIC_INFORMATION codeInfo = {};
+	MEMORY_BASIC_INFORMATION dataInfo = {};
+	ASSERT_NE(VirtualQuery(code, &codeInfo, sizeof(codeInfo)), 0u);
+	ASSERT_NE(VirtualQuery(data, &dataInfo, sizeof(dataInfo)), 0u);
+	EXPECT_EQ(codeInfo.AllocationBase, dataInfo.AllocationBase);
+#endif
+}
