# GN args shared by every oxgl ANGLE bundle. Platform files are appended.
is_debug = false
is_component_build = false
symbol_level = 1
angle_build_tests = false
angle_has_frame_capture = false
angle_enable_vulkan = true
angle_enable_swiftshader = true
angle_enable_gl = false
angle_enable_null = false
angle_enable_perfetto = false
# ANGLE enables its WebGPU backend by default on macOS and Windows; it links
# Dawn (and DXC on Windows), which oxgl does not use.
angle_enable_wgpu = false
